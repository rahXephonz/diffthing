---
import Base from "../layouts/Base.astro";
import Sections from "../components/Sections.astro";
import HeroPreview from "../components/HeroPreview.tsx";
import { REVEAL, EYEBROW, LEAD, HERO_CTA, BTN_PRIMARY, BTN_GHOST } from "../lib/ui";
import clsx from "clsx";
---

<Base>
  <!-- ===================  HERO  =================== -->
  <section class="wrap text-center pt-[clamp(120px,18vw,190px)] pb-[clamp(40px,8vw,90px)]">
    <span class={clsx(EYEBROW, REVEAL)}>Local-first AI code review</span>
    <h1 class={clsx("mx-auto mt-6.5 max-w-[16ch] text-[clamp(2.6rem,7vw,5.4rem)]", REVEAL)} data-d="1">AI organizes the <span class="hl">review.</span><br />You approve the code.</h1>
    <p class={clsx(LEAD, "mx-auto mt-6 text-center", REVEAL)} data-d="2">
      Diffthing transforms AI-generated code into a deterministic, prioritized review walkthrough.
      Every approval remains yours.
    </p>
    <div class={clsx(HERO_CTA, REVEAL)} data-d="2">
      <a class={BTN_PRIMARY} href="#install">
        Install Diffthing
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
      </a>
      <a class={BTN_GHOST} href="https://github.com/rahXephonz/diffthing" target="_blank" rel="noopener">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.58 2 12.26c0 4.5 2.87 8.32 6.84 9.67.5.1.68-.22.68-.48v-1.7c-2.78.62-3.37-1.2-3.37-1.2-.45-1.18-1.1-1.5-1.1-1.5-.9-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.9 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.55-1.14-4.55-5.05 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.92-2.34 4.78-4.57 5.03.36.32.68.94.68 1.9v2.82c0 .27.18.59.69.48A10.02 10.02 0 0 0 22 12.26C22 6.58 17.52 2 12 2Z"></path></svg>
        View on GitHub
      </a>
    </div>
    <div class={clsx("mt-8.5 flex flex-wrap items-center justify-center gap-2.5 font-sans text-[13px] text-muted", REVEAL)} data-d="3">
      <b class="font-medium text-text">Agent writes code</b><span class="text-acid">→</span><b class="font-medium text-text">AI organizes the review</b><span class="text-acid">→</span><b class="font-medium text-text">Humans approve</b>
    </div>

    <HeroPreview client:visible />
  </section>

  <Sections />
</Base>
